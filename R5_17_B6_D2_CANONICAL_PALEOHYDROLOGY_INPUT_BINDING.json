      "relevant_equation_lines": [
        {
          "line": 195,
          "text": "river_discharge_threshold_m3_s=45.0,"
        },
        {
          "line": 201,
          "text": "p = climate.precipitation_mm_yr"
        },
        {
          "line": 202,
          "text": "pet = climate.potential_evapotranspiration_mm_yr"
        },
        {
          "line": 204,
          "text": "aet = budyko_aet(p, pet)"
        },
        {
          "line": 205,
          "text": "surplus = np.maximum(p - aet, 0.0)"
        },
        {
          "line": 207,
          "text": "infiltration = lithology_infiltration_fraction(geology.lithology_code)"
        },
        {
          "line": 209,
          "text": "# Most infiltrated annual water eventually returns to the surface system;"
        },
        {
          "line": 210,
          "text": "# the rest is retained in deep groundwater/storage on this timescale."
        },
        {
          "line": 211,
          "text": "groundwater_return = 0.72"
        },
        {
          "line": 212,
          "text": "effective_runoff_fraction = 1.0 - infiltration * (1.0 - groundwater_return)"
        },
        {
          "line": 214,
          "text": "# Permanent ice stores a larger part of annual precipitation; snow in"
        },
        {
          "line": 216,
          "text": "cryo_storage = np.clip("
        },
        {
          "line": 222,
          "text": "runoff = surplus * effective_runoff_fraction * (1.0 - cryo_storage)"
        },
        {
          "line": 223,
          "text": "runoff *= land"
        },
        {
          "line": 226,
          "text": "local_volume_m3_yr = runoff * 1e-3 * area_km2 * 1e6"
        },
        {
          "line": 228,
          "text": "routed_volume = _route_volume("
        },
        {
          "line": 232,
          "text": "discharge = routed_volume / SECONDS_PER_YEAR"
        },
        {
          "line": 235,
          "text": "actual = structural & (discharge >= river_discharge_threshold_m3_s)"
        },
        {
          "line": 247,
          "text": "& (runoff < 15.0)"
        },
        {
          "line": 254,
          "text": "discharge,"
        },
        {
          "line": 259,
          "text": "\"river_discharge_threshold_m3_s\": float(river_discharge_threshold_m3_s),"
        },
        {
          "line": 260,
          "text": "\"groundwater_return_fraction\": groundwater_return,"
        },
        {
          "line": 262,
          "text": "\"Annual runoff uses Budyko-style P/PET balance.\","
        },
        {
          "line": 265,
          "text": "\"Lake persistence uses catchment inflow proxy versus open-water evaporation.\","
        },
        {
          "line": 272,
          "text": "actual_evapotranspiration_mm_yr=aet,"
        },
        {
          "line": 273,
          "text": "climatic_runoff_mm_yr=runoff,"
        },
        {
